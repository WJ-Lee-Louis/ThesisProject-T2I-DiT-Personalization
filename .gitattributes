# Keep scripts executable by Bash and code hashes portable across checkouts.
*.sh text eol=lf
*.py text eol=lf

# Model-comparison image archives are Git LFS objects; Git stores only pointers.
diptych/artifacts/**/*.zip filter=lfs diff=lfs merge=lfs -text
mosaic/artifacts/**/*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve byte hashes used by the benchmark manifests, scores and receipts.
freecus/results/** -text
dreamo/results/** -text
uno/results/** -text
xverse/results/** -text
diptych/results/** -text
mosaic/results/** -text
freecus/manifests/** -text
dreamo/manifests/** -text
uno/manifests/** -text
diptych/manifests/** -text
mosaic/manifests/** -text

xlabs_application/results/** -text
xlabs_application/manifests/** -text
Orthogonalization-InstantX-IP-Adapter/outputs/benchmark_metrics_v1/** -text
# Vendored research contracts retain their recorded original byte hashes.
xlabs_application/vendor/** -text
xlabs_application/requirements*.txt text eol=lf
